{
  "scenarios": [
    {
      "name": "sync-lazy-lru",
      "description": "SYNC刷盘 + LAZY过期 + LRU淘汰 - 数据安全优先",
      "wal": {
        "flushStrategy": "SYNC",
        "flushIntervalMs": 1000
      },
      "expiry": {
        "strategy": "LAZY",
        "scanIntervalMs": 1000
      },
      "memory": {
        "evictionStrategy": "LRU",
        "maxSizeMB": 100,
        "evictionRatio": 0.8
      },
      "benchmark": {
        "warmupIterations": 3,
        "warmupTime": 1,
        "measurementIterations": 5,
        "measurementTime": 3,
        "forks": 1,
        "threads": 1
      }
    },
